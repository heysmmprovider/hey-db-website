---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import workspace from '../assets/workspace.png';
import { projects } from '../data/projects';
import { site } from '../data/site';
import '../styles/global.css';

const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;
const features = [
  { number: '01', icon: 'database', title: 'Find your way around.', description: 'Save your connections and explore tables, views, columns, and indexes. Your database, neatly in view.', label: 'CONNECT & EXPLORE' },
  { number: '02', icon: 'terminal', title: 'Get into your query flow.', description: 'SQL tabs, syntax highlighting, and schema completion. Write a query, run a statement, see what’s there.', label: 'WRITE & RUN' },
  { number: '03', icon: 'table', title: 'From rows to real work.', description: 'Edit cells, review the SQL, and apply your changes in one transaction. Export loaded results to CSV.', label: 'EDIT & EXPORT' },
];
const faqs = [
  { question: 'Which databases can I connect to?', answer: 'hey db currently supports PostgreSQL. Other database engines are not supported in version 0.1.' },
  { question: 'Does my data leave my computer?', answer: 'hey db connects directly from your computer to the PostgreSQL server you choose. There’s no hosted hey db backend, account, or telemetry. Query tabs and loaded results stay in memory; remembered passwords use your operating system’s credential store.' },
  { question: 'How do I install hey db?', answer: 'Click Download for Mac to get the DMG installer. Open it, drag hey db into Applications, and launch the app. You can connect to an existing PostgreSQL database or try the built-in demo. No source build, Node.js, or Rust installation is needed.' },
  { question: 'Which computers are supported?', answer: 'The download is for Apple Silicon (M-series) Macs running macOS 13 Ventura or later. Intel Mac, Windows, and Linux installers are not available in this release.' },
  { question: 'Is this preview Apple-notarized?', answer: 'This early preview is ad-hoc signed and is not Apple-notarized, so macOS may block the first launch. The installation guide links to Apple’s instructions and includes steps for checking the download against its published checksum.' },
  { question: 'Is hey db really free?', answer: 'Yes. hey db is open source under the MIT license. You can use it, inspect the code, modify it, and contribute on GitHub.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9f5" />
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="hey db — A calmer place for your database" />
    <meta property="og:description" content={site.description} />
    <meta property="og:site_name" content={site.name} />
    {canonical && <meta property="og:url" content={canonical} />}
    {Astro.site && <meta property="og:image" content={new URL('/og-image.png', Astro.site).href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>hey db — The open-source PostgreSQL workspace</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareSourceCode',
      name: site.name,
      description: site.description,
      codeRepository: site.repository,
      license: 'https://opensource.org/license/mit',
      programmingLanguage: ['Rust', 'TypeScript'],
      version: site.version,
      ...(canonical ? { url: canonical } : {}),
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href="#" aria-label="hey db home"><span class="brand-icon"><Icon name="database" size={21} /></span>hey db<span class="brand-period">.</span></a>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="#features">Features</a>
        <a href="#open-source">Open source</a>
        <a href="#download">Download</a>
      </nav>
      <a class="header-github" href={site.repository} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} /><span>GitHub</span><Icon name="arrow" size={14} /></a>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <a class="eyebrow-pill" href="#open-source"><span class="status-dot"></span> A little tool. An open-source heart. <Icon name="right" size={14} /></a>
        <h1 id="hero-title">Your database. <br /><span>A calmer place to work.</span></h1>
        <p class="hero-description">Meet hey db. A focused PostgreSQL workspace for exploring, <br class="desktop-break" /> querying, and making yourself at home in your data.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={site.macDownload}><Icon name="down" size={18} /> Download for Mac</a>
          <a class="button button-secondary" href={site.repository} target="_blank" rel="noopener noreferrer"><Icon name="github" size={18} /> View on GitHub <Icon name="arrow" size={16} /></a>
        </div>
        <p class="hero-note">Apple Silicon <span>·</span> macOS 13+ <span>·</span> Free & open source</p>

        <figure class="workspace-figure">
          <div class="workspace-backdrop">
            <div class="preview-label"><span class="status-dot"></span> LESS FRICTION. MORE FLOW.</div>
            <button class="workspace-image-button" id="open-preview" aria-label="Enlarge the hey db application screenshot" aria-haspopup="dialog">
              <Image src={workspace} alt="The hey db desktop app showing a PostgreSQL schema explorer, SQL query editor, and a product results table with synthetic demo data." widths={[640, 960, 1280]} sizes="(max-width: 700px) 92vw, 1040px" width={1280} height={840} format="webp" loading="eager" fetchpriority="high" />
              <span class="preview-expand"><Icon name="arrow" size={16} /> Take a closer look</span>
            </button>
          </div>
          <figcaption><span class="caption-label"><span class="status-dot"></span> YOUR WORKSPACE, SIMPLIFIED.</span><span>Actual app · Sample data · v{site.version}</span></figcaption>
        </figure>
      </section>

      <section class="features-section container" id="features" aria-labelledby="features-title">
        <div class="section-heading"><div><p class="eyebrow">SMALL BY DESIGN</p><h2 id="features-title">The essentials. <br />Room to focus.</h2></div><p>From the first connection to the final query. <br />A thoughtful home for your everyday database work.</p></div>
        <div class="features-grid">
          {features.map((feature) => <article class="feature-card"><div class="feature-top"><span class="feature-icon"><Icon name={feature.icon} size={24} /></span><span class="feature-number">{feature.number}</span></div><p class="feature-label">{feature.label}</p><h3>{feature.title}</h3><p>{feature.description}</p></article>)}
        </div>
        <div class="privacy-note"><Icon name="shield" size={19} /><p><strong>Your data stays your business.</strong> Direct database connections. No account. No telemetry.</p><a href={`${site.repository}#local-data-and-privacy`} target="_blank" rel="noopener noreferrer">Read about privacy <Icon name="arrow" size={15} /></a></div>
      </section>

      <section class="open-source-section container" id="open-source" aria-labelledby="open-source-title">
        <div class="open-source-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div><div class="code-spark spark-one">{`{ }`}</div><div class="code-spark spark-two">+</div><div class="code-spark spark-three">_</div><div class="source-symbol"><Icon name="code" size={70} /></div><span class="art-caption">BUILT IN THE OPEN.</span></div>
        <div class="open-source-copy"><p class="eyebrow">YOURS TO MAKE BETTER</p><h2 id="open-source-title">Good tools grow <br />in the open.</h2><p>hey db is a small, independent project with an open door. Read the code, report a rough edge, or help build what comes next.</p><p>Free to use. Free to change. MIT licensed.</p><a class="text-link" href={site.repository} target="_blank" rel="noopener noreferrer">Find your place on GitHub <Icon name="arrow" size={19} /></a></div>
      </section>

      <section class="download-section container" id="download" aria-labelledby="download-title">
        <div class="download-card">
          <div class="download-copy">
            <span class="release-label"><span class="status-dot"></span> EARLY DAYS. OPEN POSSIBILITIES.</span>
            <h2 id="download-title">Say hey to <br />your database.</h2>
            <p>A little more clarity in your everyday work. <br />Download the app and make yourself at home.</p>
            <div class="download-actions">
              <a class="button button-lime" href={site.macDownload}><Icon name="down" size={18} /> Download for Mac <span class="button-format">.dmg</span></a>
              <a class="download-guide" href={site.installGuide} target="_blank" rel="noopener noreferrer">Install guide <Icon name="arrow" size={16} /></a>
            </div>
            <p class="release-note">Apple Silicon · macOS 13 or later · v{site.version}</p>
            <p class="release-note">Early preview · Not Apple-notarized. <a href={site.installGuide} target="_blank" rel="noopener noreferrer">First-launch help <Icon name="arrow" size={12} /></a></p>
          </div>
          <div class="download-terminal">
            <div class="terminal-header"><span><i></i><i></i><i></i></span><span>ready in a few clicks</span><Icon name="check" size={15} /></div>
            <ol class="install-steps">
              <li><span class="install-step-number">01</span><div><strong>Open the download.</strong><p>Double-click the hey db .dmg file.</p></div></li>
              <li><span class="install-step-number">02</span><div><strong>Make it at home.</strong><p>Drag hey db into Applications.</p></div></li>
              <li><span class="install-step-number">03</span><div><strong>Say hey to your data.</strong><p>Launch the app. Connect or try the demo.</p></div></li>
            </ol>
            <div class="terminal-footer install-footer"><span>Prefer to build it yourself?</span><a href={site.sourceDownload}>Download source <Icon name="arrow" size={13} /></a></div>
          </div>
        </div>
      </section>

      <section class="faq-section container" aria-labelledby="faq-title"><div><p class="eyebrow">A FEW THINGS TO KNOW</p><h2 id="faq-title">Before you <br />say hello.</h2></div><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}<span class="faq-toggle"><Icon name="plus" size={19} /></span></summary><p>{faq.answer}</p></details>)}</div></section>
    </main>

    <footer class="site-footer container"><div class="footer-main"><div><a class="wordmark" href="#" aria-label="hey db home"><span class="brand-icon"><Icon name="database" size={18} /></span>hey db<span class="brand-period">.</span></a><p>A little closer to your data.</p></div><div class="footer-links"><a href={site.repository} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow" size={14} /></a><a href={site.releases} target="_blank" rel="noopener noreferrer">Releases <Icon name="arrow" size={14} /></a><a href={`${site.repository}/issues`} target="_blank" rel="noopener noreferrer">Feedback <Icon name="arrow" size={14} /></a></div></div><div class="other-projects"><p>ALSO BY THE MAKER <span>A few other projects that keep us building.</span></p><ul>{projects.map((domain) => <li><a href={`https://${domain}`} target="_blank" rel="noopener">{domain}</a></li>)}</ul></div><div class="footer-bottom"><span>© {new Date().getFullYear()} hey db. Open source, with care.</span><a href={`${site.repository}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">Made to be shared. MIT licensed. <Icon name="arrow" size={12} /></a></div></footer>

    <dialog id="preview-dialog" aria-label="hey db application screenshot"><button class="dialog-close" id="close-preview" aria-label="Close screenshot preview"><Icon name="close" size={23} /></button><img src={workspace.src} width="1280" height="840" alt="Full-size hey db workspace with the schema explorer, SQL editor, and synthetic product results." loading="lazy" /><p>hey db v{site.version} · Synthetic sample data</p></dialog>

    <script>
      const preview = document.querySelector<HTMLDialogElement>('#preview-dialog');
      document.querySelector('#open-preview')?.addEventListener('click', () => preview?.showModal());
      document.querySelector('#close-preview')?.addEventListener('click', () => preview?.close());
      preview?.addEventListener('click', (event) => { if (event.target === preview) preview.close(); });
    </script>
  </body>
</html>
